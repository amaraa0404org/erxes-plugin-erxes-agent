# Copy to .env — erxes-agent_api runtime config
NODE_ENV=development

MONGO_URL=mongodb://127.0.0.1:27017/erxes?directConnection=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT secret shared with core — used to sign cf-os connect codes
# JWT_TOKEN_SECRET=

# Shared secret for POST /cf-os/exchange (gatekeeper-only route)
# CF_OS_EXCHANGE_SECRET=

# Set on erxes saas only: resolves per-subdomain org databases
# VERSION=saas
# CORE_MONGO_URL=mongodb://...
# DB_NAME=erxes_<organizationId>

# Plugin release line — drives the UI remoteEntry version core serves
# RELEASE_VERSION=3.0.0

# Public address the gateway should proxy to instead of plugin-erxes-agent-api:3306
# LOAD_BALANCER_ADDRESS=http://erxes-agent-api:3306
