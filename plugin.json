{
  "name": "erxes-agent",
  "version": "0.1.2",
  "description": "AI agents chat — BYOK multi-provider assistant, threads, approvals and artifacts for erxes",
  "icon": "IconSparkles",
  "artifact": {
    "url": "https://github.com/amaraa0404org/erxes-plugin-erxes-agent/releases/download/v0.1.2/erxes-agent-0.1.2.tgz"
  },
  "api": {
    "port": 3306,
    "health": "/health",
    "env": [
      "MONGO_URL",
      "REDIS_HOST",
      "REDIS_PORT",
      "REDIS_PASSWORD",
      "JWT_TOKEN_SECRET",
      "CF_OS_EXCHANGE_SECRET"
    ],
    "hasSubscriptions": true
  },
  "ui": {
    "remote": "erxes_agent_ui",
    "entry": "https://amaraa0404org.github.io/erxes-plugin-erxes-agent/dist/latest/erxes_agent_ui/remoteEntry.js",
    "exposes": [
      "./config",
      "./erxes_agent",
      "./erxes_agentSettings",
      "./floatingWidget"
    ]
  }
}
